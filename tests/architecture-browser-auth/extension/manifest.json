{
  "manifest_version": 3,
  "name": "xDownload Architecture Browser Auth E3 Demo",
  "version": "0.1.0",
  "description": "Research-only E3 fixture for browser observation and scoped auth broker.",
  "key": "",
  "permissions": ["nativeMessaging", "cookies", "webRequest", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
